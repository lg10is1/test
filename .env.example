# Copy to .env only if your local launcher reads environment files.
# Do not commit .env.
EOSCZ_PROJECT_ROOT=/path/to/local/project
EOSCZ_REFERENCE_DIR=/path/to/reference
EOSCZ_REFERENCE_FASTA=/path/to/reference.fasta
EOSCZ_OUTPUT_DIR=/path/to/output
EOSCZ_SCRNA_INPUT_DIR=/path/to/single_cell_matrix
EOSCZ_SNAPSEED_MARKERS=/path/to/marker_definitions.yaml
